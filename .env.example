# Variables de entorno del backend. Copiar a .env en local; en Railway se
# configuran en el servicio. Las marcadas (opcional) pueden quedar vacías.

# ---------- Base de datos ----------
DATABASE_URL="postgresql://usuario:password@localhost:5432/dardos_club"

# ---------- Club ----------
# Nombre corto del club (equipo/competición por defecto). Por defecto: Vikings
CLUB_NOMBRE="Vikings"
# URL pública de la web, sin barra final (enlaces de avisos y de Telegram)
FRONTEND_URL="https://www.vikingsdartsclub.es"

# ---------- Seguridad ----------
# Cadenas largas y aleatorias, distintas en cada club (p.ej. `openssl rand -hex 32`)
JWT_SECRET=""
# Contraseña del panel /admin
ADMIN_TOKEN=""
# Código que piden al registrarse como socio
CODIGO_INVITACION=""

# ---------- Cloudinary (fotos y vídeos) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Carpeta de subida. Si dos clubes comparten cuenta, una distinta por club.
CLOUDINARY_FOLDER="dardos-club"

# ---------- Avisos Web Push ----------
# Generar con: npx web-push generate-vapid-keys (unas nuevas por club)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@tu-club.com"

# ---------- Telegram (avisos a invitados) (opcional) ----------
# Bot creado con @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# ---------- Scrapers de plataformas (opcional) ----------
# Cuentas del club en cada plataforma, para leer medias y clasificaciones.
# Phoenix Darts no necesita cuenta.
RADIKAL_DARTS_ID=""
RADIKAL_DARTS_PASSWORD=""
CONNECTION_DARTS_EMAIL=""
CONNECTION_DARTS_PASSWORD=""
