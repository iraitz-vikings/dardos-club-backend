generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  jugador
  capitan
  admin
}

enum OrigenTorneo {
  automatico
  manual
}

enum OrigenActualizacion {
  scraper
  manual
}

enum Visibilidad {
  publico
  privado
}

model Usuario {
  id                        String   @id @default(uuid())
  nombre                    String
  email                     String   @unique
  passwordHash              String
  rol                       Rol      @default(jugador)
  aprobado                  Boolean  @default(false)
  debeCambiarPassword       Boolean  @default(false)
  creadoEn                  DateTime @default(now())

  jugador                   Jugador?
  noticias                  NoticiaEvento[]
  anuncios                  Anuncio[]
  fotosGaleria               FotoGaleriaPrivada[]
}

model Jugador {
  id        String   @id @default(uuid())
  nombre    String
  apodo     String?
  avatarUrl String?
  bio       String?
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  equipos             EquipoJugador[]
  equiposCapitaneados EquipoTorneo[] @relation("capitan")
  comoJugador1        ParticipanteCuadrante[] @relation("participanteJugador1")
  comoJugador2        ParticipanteCuadrante[] @relation("participanteJugador2")
  comoJugador1Liga ParticipanteLiga[] @relation("participanteLigaJugador1")
  comoJugador2Liga ParticipanteLiga[] @relation("participanteLigaJugador2")
  equiposClub             MiembroEquipoClub[]
  equiposCapitaneadosClub EquipoClub[]        @relation("capitanEquipoClub")
  idsFabricantes          JugadorFabricanteId[]
  suscripcionesPush       SuscripcionPush[]
  suscripcionTelegram     SuscripcionTelegram?
}

// Un dispositivo (navegador) de un socio con avisos activados. Un mismo
// Jugador puede tener varias filas (móvil + ordenador, por ejemplo): cuando
// hay que avisarle se manda a TODAS. Solo lo usan socios (jugadores con
// cuenta): el alta se hace desde "Mi perfil", vinculando automáticamente por
// la sesión ya iniciada — no hace falta ningún check-in aparte. endpoint es
// único porque lo asigna el navegador y sirve como identificador natural del
// dispositivo suscrito.
model SuscripcionPush {
  id        String   @id @default(uuid())
  jugadorId String
  jugador   Jugador  @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  creadoEn  DateTime @default(now())
}

// Vínculo entre un Jugador invitado (sin cuenta) y su chat de Telegram,
// creado cuando el invitado pulsa "Iniciar" en el bot tras abrir su enlace
// de aviso personal (/aviso/:token). Solo hace falta una vez por persona: al
// ser el Jugador invitado un registro reutilizable entre torneos, el mismo
// vínculo sirve para siempre. jugadorId es único porque cada invitado solo
// necesita (y solo puede tener) un chat de Telegram vinculado.
model SuscripcionTelegram {
  id          String   @id @default(uuid())
  jugadorId   String   @unique
  jugador     Jugador  @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  chatId      String   @unique
  username    String?
  vinculadoEn DateTime @default(now())
}

model Plataforma {
  id                    String  @id @default(uuid())
  nombre                String  @unique
  adaptador             String?
  credencialesCifradas  String?

  torneos Torneo[]
}

model Torneo {
  id            String       @id @default(uuid())
  nombre        String
  nivel         String?
  temporada     String?
  origen        OrigenTorneo
  plataformaId  String?
  plataforma    Plataforma? @relation(fields: [plataformaId], references: [id])
  // Nombre EXACTO de la competición tal como aparece en la web de la
  // plataforma (ej. "13 Vegas 2026" en Radikal Darts) — lo usa el scraper de
  // clasificación de equipos para localizarla, igual que "notaBusqueda" para
  // jugadores en JugadorFabricanteId. En Radikal es el único dato que hace
  // falta (una tabla compartida por todo el Torneo/Liga). En Phoenix ya NO
  // es el campo principal: cada equipo del club inscrito tiene su propio
  // nombre en EquipoTorneo.idExternoEquipo (necesario porque varios equipos
  // del club pueden competir a la vez en el mismo Torneo/Liga de Phoenix,
  // cada uno en su grupo); este campo solo se usa ahí como último recurso
  // si una inscripción no tiene su propio idExternoEquipo.
  idExterno     String?

  equipos EquipoTorneo[]
  clasificacion ClasificacionEquipo[]
}

// Fila de la tabla de clasificación general (equipos) de un Torneo/Liga
// externo, extraída por scraping. Incluye TODOS los equipos de la
// competición (no solo los del club), para poder ver el contexto completo
// de la liga. Se reescribe entera en cada actualización, así que siempre
// refleja el último scrapeo.
//
// equipoTorneoId es opcional: cuando la plataforma tiene UNA sola tabla de
// clasificación compartida por todo el Torneo/Liga (Radikal: se busca por
// nombre de competición), queda a null y la fila cuelga solo de torneoId.
// Cuando la plataforma exige buscar equipo por equipo y cada uno puede caer
// en un grupo distinto dentro del mismo Torneo/Liga (Phoenix: varios
// equipos del club pueden competir a la vez en la misma competición, cada
// uno en su grupo — caso real detectado el 2026-08-15 con la "Summer Cup",
// 5 equipos del club), cada EquipoTorneo tiene su propio bloque de filas.
model ClasificacionEquipo {
  id                  String   @id @default(uuid())
  torneoId            String
  torneo              Torneo   @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  equipoTorneoId      String?
  equipoTorneo        EquipoTorneo? @relation(fields: [equipoTorneoId], references: [id], onDelete: Cascade)
  posicion            Int
  nombreEquipo        String
  puntos              Float?
  partidosJugados     Int?
  partidosGanados     Int?
  partidosPerdidos    Int?
  partidosEmpatados   Int?
  juegosGanados       Int?
  juegosPerdidos      Int?
  actualizadoEn       DateTime @updatedAt
  origenActualizacion OrigenActualizacion @default(scraper)

  @@unique([torneoId, equipoTorneoId, nombreEquipo])
}

// La inscripción de un EquipoClub (el equipo del club, con su plantilla) en
// una competición externa (Torneo). No hay equipos "sueltos": todo equipo
// que compite fuera es, ante todo, un EquipoClub — esto solo guarda en qué
// competición concreta participa y sus partidos de esa competición.
// equipoClubId es opcional solo por compatibilidad con filas antiguas
// creadas antes de este cambio (que tenían el nombre del equipo suelto, sin
// enlazar a ningún EquipoClub).
model EquipoTorneo {
  id              String   @id @default(uuid())
  torneoId        String
  torneo          Torneo   @relation(fields: [torneoId], references: [id])
  equipoClubId    String?
  equipoClub      EquipoClub? @relation(fields: [equipoClubId], references: [id])
  nombreEquipo    String?  // solo se usa si no hay equipoClub (filas antiguas); si hay equipoClub, se muestra su nombre
  // Nombre EXACTO de ESTE equipo (esta inscripción concreta) tal como está
  // registrado en la plataforma externa — hace falta en plataformas como
  // Phoenix Darts, donde la clasificación se busca por equipo y no por
  // competición, y donde varios equipos del club pueden estar inscritos a
  // la vez en el mismo Torneo/Liga (cada uno en su propio grupo). Para
  // Radikal no hace falta (se usa Torneo.idExterno, compartido).
  idExternoEquipo String?
  capitanId       String?
  capitan         Jugador? @relation("capitan", fields: [capitanId], references: [id])

  jugadores EquipoJugador[]
  partidos  Partido[]
  clasificacion ClasificacionEquipo[]

  @@unique([torneoId, equipoClubId])
}

model EquipoJugador {
  id             String       @id @default(uuid())
  equipoTorneoId String
  equipoTorneo   EquipoTorneo @relation(fields: [equipoTorneoId], references: [id])
  jugadorId      String
  jugador        Jugador      @relation(fields: [jugadorId], references: [id])

  @@unique([equipoTorneoId, jugadorId])
}

model Partido {
  id                  String   @id @default(uuid())
  equipoTorneoId      String
  equipoTorneo        EquipoTorneo @relation(fields: [equipoTorneoId], references: [id])
  fecha               DateTime
  rival               String?
  resultado           String?
  fijado              Boolean  @default(false)
  notaCapitan         String?
  maquinaId           String?
  maquina             Maquina? @relation(fields: [maquinaId], references: [id])
  origenActualizacion OrigenActualizacion @default(manual)
  ultimaActualizacion DateTime @updatedAt
}

model NoticiaEvento {
  id               String   @id @default(uuid())
  titulo           String
  contenido        String
  fotos            String[]
  videos           String[] @default([])
  fechaPublicacion DateTime @default(now())
  autorId          String?
  autor            Usuario? @relation(fields: [autorId], references: [id])
}

model GaleriaItem {
  id        String   @id @default(uuid())
  url       String
  tipo      String
  creadoEn  DateTime @default(now())
}

model TorneoClub {
  id              String   @id @default(uuid())
  nombre          String
  descripcion     String?
  fechaInicio     DateTime
  fechaFin        DateTime
  insigniaUrl     String?
  visibilidad     String   @default("privado")
  numeroMaquinas  Int?
  tipoEliminacion String   @default("directa")
  modalidad       String   @default("individual")
  afectaCalendario Boolean  @default(true)
  finalizado       Boolean  @default(false)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  cuadrantes Cuadrante[]
}

model CuadroPartido {
  id       String    @id @default(uuid())
  cuadranteId String
  cuadrante   Cuadrante @relation(fields: [cuadranteId], references: [id])
  rama     String
  ronda    Int
  posicion Int
  maquina  String?
  jugador1 String?
  jugador2 String?
  resultado String?
  ganador  String?
  enCurso  Boolean @default(false)

  siguientePartidoGanadorId String?
  siguienteSlotGanador Int?
  siguientePartidoPerdedorId String?
  siguienteSlotPerdedor Int?

  fechaCalendario      DateTime?
  maquinaCalendarioId  String?
  maquinaCalendario    Maquina? @relation(fields: [maquinaCalendarioId], references: [id])
  confirmadoCalendario Boolean  @default(false)

  actualizadoEn DateTime @updatedAt
}

model TorneoDestacado {
  id            String   @id @default(uuid())
  nombre        String
  descripcion   String?
  fechaInicio   DateTime
  fechaFin      DateTime
  insigniaUrl   String?
  cartelUrl     String?
  actualizadoEn DateTime @updatedAt
}

model MensajeAnclado {
  id          String   @id @default(uuid())
  texto       String
  activo      Boolean  @default(true)
  actualizadoEn DateTime @updatedAt
}

model Patrocinador {
  id       String @id @default(uuid())
  nombre   String
  logoUrl  String
  url      String?
  orden    Int    @default(0)
  creadoEn DateTime @default(now())
}

model ParticipanteCuadrante {
  id          String    @id @default(uuid())
  cuadranteId String
  cuadrante   Cuadrante @relation(fields: [cuadranteId], references: [id])
  etiqueta    String
  jugador1Id  String?
  jugador1    Jugador?  @relation("participanteJugador1", fields: [jugador1Id], references: [id])
  jugador2Id  String?
  jugador2    Jugador?  @relation("participanteJugador2", fields: [jugador2Id], references: [id])
  creadoEn    DateTime  @default(now())

  @@unique([cuadranteId, etiqueta])
}

model Cuadrante {
  id                  String   @id @default(uuid())
  torneoClubId        String?
  torneoClub          TorneoClub? @relation(fields: [torneoClubId], references: [id])
  ligaId              String?
  liga                LigaClub? @relation(fields: [ligaId], references: [id])
  nombre              String
  tamano              Int
  tipoEliminacion     String
  metodoSorteoParejas String?
  creadoEn            DateTime @default(now())

  partidos      CuadroPartido[]
  participantes ParticipanteCuadrante[]
}

model LigaClub {
  id                  String   @id @default(uuid())
  nombre              String
  descripcion         String?
  fechaInicio         DateTime
  fechaFin            DateTime
  insigniaUrl         String?
  visibilidad         String   @default("privado")
  modalidad           String   @default("individual")
  vueltas             Int      @default(1)
  numeroParticipantes Int
  // Número de grupos en los que se divide la liga para la fase de todos
  // contra todos (round-robin dentro de cada grupo). `null` o `1` = sin
  // grupos, comportamiento de siempre (un único grupo con todos los
  // participantes). Si se define, tiene que ser un número par (>=2) para
  // poder cruzar los grupos en el cuadrante final sin ambigüedad — ver
  // lib/cruceGruposFinal.js.
  numeroGrupos        Int?
  metodoSorteoParejas String?
  afectaCalendario Boolean  @default(true)
  finalizado       Boolean  @default(false)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  participantes ParticipanteLiga[]
  partidos      PartidoLiga[]
  cuadrantes    Cuadrante[]
}

model ParticipanteLiga {
  id         String   @id @default(uuid())
  ligaId     String
  liga       LigaClub @relation(fields: [ligaId], references: [id])
  etiqueta   String
  jugador1Id String?
  jugador1   Jugador? @relation("participanteLigaJugador1", fields: [jugador1Id], references: [id])
  jugador2Id String?
  jugador2   Jugador? @relation("participanteLigaJugador2", fields: [jugador2Id], references: [id])
  // Grupo de liga (round-robin) al que pertenece: "A", "B"... `null` si la
  // liga no usa grupos o si todavía no se le ha asignado uno. No confundir
  // con el grupo de nivel (A/B/C/D) del sorteo de parejas ciegas — ese es
  // un concepto aparte, transitorio, que nunca se guarda en este campo.
  grupo      String?
  creadoEn   DateTime @default(now())

  @@unique([ligaId, etiqueta])
}

model PartidoLiga {
  id            String   @id @default(uuid())
  ligaId        String
  liga          LigaClub @relation(fields: [ligaId], references: [id])
  jornada       Int
  posicion      Int
  participante1 String
  participante2 String
  // Grupo de liga al que pertenece este enfrentamiento (mismo valor que el
  // `grupo` de sus dos participantes en el momento de generar el
  // calendario). `null` si la liga no usa grupos.
  grupo         String?
  resultado     String?
  ganador       String?
  maquina       String?
  enCurso       Boolean  @default(false)

  fechaCalendario      DateTime?
  maquinaCalendarioId  String?
  maquinaCalendario    Maquina? @relation(fields: [maquinaCalendarioId], references: [id])
  confirmadoCalendario Boolean  @default(false)

  actualizadoEn DateTime @updatedAt
}

model Anuncio {
  id               String   @id @default(uuid())
  titulo           String
  contenido        String
  fijado           Boolean  @default(false)
  autorId          String
  autor            Usuario  @relation(fields: [autorId], references: [id])
  fechaPublicacion DateTime @default(now())
}
model FotoGaleriaPrivada {
  id          String   @id @default(uuid())
  url         String
  descripcion String?
  autorId     String
  autor       Usuario  @relation(fields: [autorId], references: [id])
  fechaSubida DateTime @default(now())
}

model Trofeo {
  id          String   @id @default(uuid())
  titulo      String
  anio        Int
  ganador     String
  imagenUrl   String?
  descripcion String?
  creadoEn    DateTime @default(now())
}

model EquipoClub {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  escudoUrl   String?
  capitanId   String?
  capitan     Jugador? @relation("capitanEquipoClub", fields: [capitanId], references: [id])
  creadoEn    DateTime @default(now())

  miembros MiembroEquipoClub[]
  inscripciones EquipoTorneo[]
}

model MiembroEquipoClub {
  id        String     @id @default(uuid())
  equipoId  String
  equipo    EquipoClub @relation(fields: [equipoId], references: [id])
  jugadorId String
  jugador   Jugador    @relation(fields: [jugadorId], references: [id])
  creadoEn  DateTime   @default(now())

  @@unique([equipoId, jugadorId])
}

model Maquina {
  id       String    @id @default(uuid())
  nombre   String    @unique
  creadoEn DateTime  @default(now())

  partidos       Partido[]
  cuadroPartidos CuadroPartido[]
  partidosLiga   PartidoLiga[]
}

// Fabricante de dianas/máquinas electrónicas (ej: DARTSLIVE, Granboard...) en
// cuya web cada jugador tiene su propio ID de jugador y sus medias/estadísticas.
model Fabricante {
  id                 String   @id @default(uuid())
  nombre             String   @unique
  urlPerfilPlantilla String?  // plantilla de URL con "{id}" como marcador, ej: https://.../jugador/{id}
  logoUrl            String?  // logo del fabricante (Cloudinary), para mostrarlo junto a las medias
  creadoEn           DateTime @default(now())

  idsJugadores JugadorFabricanteId[]
}

// El ID que un jugador concreto tiene dado de alta en la web de un fabricante.
model JugadorFabricanteId {
  id           String     @id @default(uuid())
  jugadorId    String
  jugador      Jugador    @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  fabricanteId String
  fabricante   Fabricante @relation(fields: [fabricanteId], references: [id], onDelete: Cascade)
  idExterno    String
  actualizadoEn DateTime  @updatedAt

  // Pista de búsqueda opcional, más allá del alias, para fabricantes cuyo
  // scraper la necesita para poder localizar al jugador. Hoy solo la usa
  // Radikal Darts: no existe ningún buscador general de jugadores en su web,
  // pero cada competición/torneo sí tiene una página de clasificación
  // pública con el alias y la media de cada participante — aquí se guarda el
  // nombre de un torneo en el que el jugador haya participado, para que el
  // scraper sepa en qué clasificación buscarlo.
  notaBusqueda String?

  // Media/estadísticas obtenidas automáticamente de la web del fabricante
  // (ver src/scrapers). Nulas hasta la primera actualización correcta.
  // mpr/ppd: media única (así la da Phoenix Darts, y también Radikal Darts
  // por torneo). mpr/ppd Virtual y Presencial: Connection Darts distingue
  // esas dos medias por separado; se guardan en columnas aparte en vez de
  // reutilizar mpr/ppd para no mezclar ambos significados en un mismo par de
  // campos.
  mpr                Float?
  ppd                Float?
  mprVirtual         Float?
  ppdVirtual         Float?
  mprPresencial      Float?
  ppdPresencial      Float?
  statsActualizadoEn DateTime?
  statsError         String?

  @@unique([jugadorId, fabricanteId])
}
