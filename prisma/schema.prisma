generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  jugador
  capitan
  admin
}

enum OrigenTorneo {
  automatico
  manual
}

enum OrigenActualizacion {
  scraper
  manual
}

enum Visibilidad {
  publico
  privado
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(jugador)
  aprobado     Boolean  @default(false)
  creadoEn     DateTime @default(now())

  jugador                   Jugador?
  noticias                  NoticiaEvento[]
  notificacionesDisparadas  Notificacion[]
}

model Jugador {
  id        String   @id @default(uuid())
  nombre    String
  apodo     String?
  avatarUrl String?
  bio       String?
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  equipos             EquipoJugador[]
  equiposCapitaneados EquipoTorneo[] @relation("capitan")
  comoJugador1        ParticipanteCuadrante[] @relation("participanteJugador1")
  comoJugador2        ParticipanteCuadrante[] @relation("participanteJugador2")
}

model Plataforma {
  id                    String  @id @default(uuid())
  nombre                String  @unique
  adaptador             String?
  credencialesCifradas  String?

  torneos Torneo[]
}

model Torneo {
  id            String       @id @default(uuid())
  nombre        String
  nivel         String?
  temporada     String?
  origen        OrigenTorneo
  plataformaId  String?
  plataforma    Plataforma? @relation(fields: [plataformaId], references: [id])
  idExterno     String?

  equipos EquipoTorneo[]
}

model EquipoTorneo {
  id              String   @id @default(uuid())
  torneoId        String
  torneo          Torneo   @relation(fields: [torneoId], references: [id])
  nombreEquipo    String?
  idExternoEquipo String?
  capitanId       String?
  capitan         Jugador? @relation("capitan", fields: [capitanId], references: [id])

  jugadores EquipoJugador[]
  partidos  Partido[]
}

model EquipoJugador {
  id             String       @id @default(uuid())
  equipoTorneoId String
  equipoTorneo   EquipoTorneo @relation(fields: [equipoTorneoId], references: [id])
  jugadorId      String
  jugador        Jugador      @relation(fields: [jugadorId], references: [id])

  @@unique([equipoTorneoId, jugadorId])
}

model Partido {
  id                  String              @id @default(uuid())
  equipoTorneoId      String
  equipoTorneo        EquipoTorneo        @relation(fields: [equipoTorneoId], references: [id])
  fecha               DateTime
  rival               String?
  resultado           String?
  fijado              Boolean             @default(false)
  notaCapitan         String?
  origenActualizacion OrigenActualizacion @default(manual)
  ultimaActualizacion DateTime            @updatedAt

  notificaciones Notificacion[]
}

model Notificacion {
  id              String    @id @default(uuid())
  partidoId       String
  partido         Partido   @relation(fields: [partidoId], references: [id])
  mensaje         String
  enviadaEn       DateTime  @default(now())
  disparadaPorId  String?
  disparadaPor    Usuario?  @relation(fields: [disparadaPorId], references: [id])
}

model NoticiaEvento {
  id               String   @id @default(uuid())
  titulo           String
  contenido        String
  fotos            String[]
  videos           String[] @default([])
  fechaPublicacion DateTime @default(now())
  autorId          String?
  autor            Usuario? @relation(fields: [autorId], references: [id])
}

model GaleriaItem {
  id        String   @id @default(uuid())
  url       String
  tipo      String
  creadoEn  DateTime @default(now())
}

model TorneoClub {
  id              String   @id @default(uuid())
  nombre          String
  descripcion     String?
  fechaInicio     DateTime
  fechaFin        DateTime
  insigniaUrl     String?
  visibilidad     String   @default("privado")
  numeroMaquinas  Int?
  tipoEliminacion String   @default("directa")
  modalidad       String   @default("individual")
  finalizado      Boolean  @default(false)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  cuadrantes Cuadrante[]
}

model CuadroPartido {
  id            String    @id @default(uuid())
  cuadranteId   String
  cuadrante     Cuadrante @relation(fields: [cuadranteId], references: [id])
  rama          String // "ganadores" | "perdedores" | "final"
  ronda         Int
  posicion      Int
  maquina       String?
  jugador1      String?
  jugador2      String?
  resultado     String?
  ganador       String?
  enCurso       Boolean   @default(false)

  siguientePartidoGanadorId  String?
  siguienteSlotGanador       Int?
  siguientePartidoPerdedorId String?
  siguienteSlotPerdedor      Int?

  actualizadoEn DateTime  @updatedAt
}

model TorneoDestacado {
  id            String   @id @default(uuid())
  nombre        String
  descripcion   String?
  fechaInicio   DateTime
  fechaFin      DateTime
  insigniaUrl   String?
  cartelUrl     String?
  actualizadoEn DateTime @updatedAt
}

model MensajeAnclado {
  id          String   @id @default(uuid())
  texto       String
  activo      Boolean  @default(true)
  actualizadoEn DateTime @updatedAt
}

model Patrocinador {
  id       String @id @default(uuid())
  nombre   String
  logoUrl  String
  url      String?
  orden    Int    @default(0)
  creadoEn DateTime @default(now())
}

model ParticipanteCuadrante {
  id          String    @id @default(uuid())
  cuadranteId String
  cuadrante   Cuadrante @relation(fields: [cuadranteId], references: [id])
  etiqueta    String
  jugador1Id  String?
  jugador1    Jugador?  @relation("participanteJugador1", fields: [jugador1Id], references: [id])
  jugador2Id  String?
  jugador2    Jugador?  @relation("participanteJugador2", fields: [jugador2Id], references: [id])
  creadoEn    DateTime  @default(now())

  @@unique([cuadranteId, etiqueta])
}

model Cuadrante {
  id                   String   @id @default(uuid())
  torneoClubId         String
  torneoClub           TorneoClub @relation(fields: [torneoClubId], references: [id])
  nombre               String
  tamano               Int
  tipoEliminacion      String
  metodoSorteoParejas  String?
  creadoEn             DateTime @default(now())

  partidos      CuadroPartido[]
  participantes ParticipanteCuadrante[]
}
